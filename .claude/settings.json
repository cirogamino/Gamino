{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run test -- --run)",
      "Bash(npx vitest run *)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run cf-typegen)",
      "Bash(npm run preview)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(cat package.json)",
      "Bash(mkdir *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "command": "npm install --prefer-offline --no-audit 2>/dev/null || npm install",
        "timeout": 120000
      }
    ]
  }
}
